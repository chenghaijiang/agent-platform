# 复制为 .env 后按需修改；含 CHANGEME 的密钥用下方命令生成
#   openssl rand -hex 32   # 生成 32 字节十六进制串
#
# 生成一次完整的 .env（示例）：
#   cp .env.example .env
#   printf 'LANGFUSE_NEXTAUTH_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
#   printf 'LANGFUSE_SALT=%s\n' "$(openssl rand -hex 32)" >> .env
#   printf 'LANGFUSE_ENCRYPTION_KEY=%s\n' "$(openssl rand -hex 32)" >> .env

# ---------------- 平台应用 ----------------
APP_VERSION=0.1.0
APP_ENV=local

# 认证（T02，ADR-006）：access token 签名密钥（必须生成，compose 中 :? 强制拦截缺失）
AUTH_SECRET=                        # CHANGEME: openssl rand -hex 32
# 初始管理员口令（seed 仅在首次创建时使用）
ADMIN_INITIAL_PASSWORD=Changeme-1234   # CHANGEME

# 平台主库（PG + pgvector）。本地演示默认值；企业化时必须更换并收敛端口暴露
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres            # CHANGEME
POSTGRES_DB=agent_platform

# 平台 Redis 暂无密码（绑定 127.0.0.1，仅本机可达）

# ---------------- Langfuse ----------------
# 镜像版本（web/worker 共用）
LANGFUSE_IMAGE_TAG=4

LANGFUSE_POSTGRES_USER=postgres
LANGFUSE_POSTGRES_PASSWORD=postgres   # CHANGEME
LANGFUSE_POSTGRES_DB=postgres

LANGFUSE_REDIS_AUTH=langfuse-redis-secret   # CHANGEME
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse     # CHANGEME

LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret    # CHANGEME

# 三个密钥必须生成，compose 中已用 :? 校验缺失即报错
LANGFUSE_NEXTAUTH_SECRET=                   # CHANGEME: openssl rand -hex 32
LANGFUSE_SALT=                              # CHANGEME: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=                    # CHANGEME: openssl rand -hex 32

# 首次启动自动初始化的登录账号（仅数据卷首次创建时生效）
LANGFUSE_INIT_ORG_ID=agent-platform-org
LANGFUSE_INIT_ORG_NAME=Agent Platform
LANGFUSE_INIT_PROJECT_ID=agent-platform-project
LANGFUSE_INIT_PROJECT_NAME=Agent Platform MVP
LANGFUSE_INIT_USER_EMAIL=admin@agent-platform.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=Changeme-1234   # CHANGEME

# 项目 API keys（应用上报观测用；显式固定，重建数据卷后仍不变）
# 格式：pk-lf- 前缀 + openssl rand -hex 16；sk-lf- 前缀 + openssl rand -hex 32
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-     # CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-     # CHANGEME

# ---------------- 模型网关（T03，v0.2 §5.5 M1） ----------------
# 模型映射表 + 凭证（凭证仅存 .env，永不落代码仓库）。三形态改 4 行 + docker compose up -d 即切换，零代码改动：
#
# ① 演示（默认）：compose 内 fake-openai，免真实 key 走通网关与观测链路
#MODEL_GATEWAY_BASE_URL=http://fake-openai:8000/v1
MODEL_GATEWAY_BASE_URL=http://localhost:11434/v1
MODEL_GATEWAY_API_KEY=demo-key-not-for-prod
# 服务间共享密钥：harness sidecar 的模型出口经平台 OpenAI 兼容代理（compose 内固定指向 app）
# 平台用 Bearer 校验该 key，未配置时代理端点关闭（sidecar 模型调用不可用）
MODEL_GATEWAY_PROXY_KEY=change-me-random-hex
#MODEL_CHAT_MODEL=demo-chat-1
#MODEL_EMBEDDING_MODEL=demo-embedding-1
MODEL_CHAT_MODEL=qwen3.8:27b-mlx
MODEL_EMBEDDING_MODEL=qwen3-embedding:0.6b
#
# ② 线上：任一 OpenAI-compatible 云服务
#   OpenAI:  MODEL_GATEWAY_BASE_URL=https://api.openai.com/v1    MODEL_GATEWAY_API_KEY=sk-xxx
#            MODEL_CHAT_MODEL=gpt-4o-mini                        MODEL_EMBEDDING_MODEL=text-embedding-3-small
#   DeepSeek: MODEL_GATEWAY_BASE_URL=https://api.deepseek.com/v1  MODEL_CHAT_MODEL=deepseek-chat
#            （DeepSeek 无 embedding 端点，EMBEDDING 可另配其他服务）
#
# ③ 本地：宿主机 Ollama / vLLM / LM Studio（均提供 OpenAI-compatible 端点）
#   Ollama:  MODEL_GATEWAY_BASE_URL=http://host.docker.internal:11434/v1
#            MODEL_CHAT_MODEL=qwen3.8:27b-mlx                    MODEL_EMBEDDING_MODEL=qwen3-embedding:0.6b
#   vLLM:    MODEL_GATEWAY_BASE_URL=http://host.docker.internal:8001/v1（模型名为部署时 --served-model-name）
#   API_KEY 无需真实值：本地服务不校验 Authorization，保留占位即可；
#   compose 已为 app/worker 注入 host.docker.internal→host-gateway 映射（Linux 亦可用）
#
# ⚠️ 切换 EMBEDDING 模型后必须清空已入库向量重建（不同模型向量空间不可混用）：
#   docker exec agent-platform-db-1 psql -U postgres -d agent_platform -c "TRUNCATE kb_chunks, ingest_tasks"
#   （chat 模型切换无此约束；embedding 列为无维度 vector，换维度模型无需改表）

# ---------------- 平台对象存储（T05，MinIO，独立于 Langfuse 实例） ----------------
MINIO_ROOT_USER=agentplatform             # CHANGEME
MINIO_ROOT_PASSWORD=agent-minio-secret    # CHANGEME
MINIO_BUCKET=agent-platform-documents

# ---------------- 入库任务（T05，ADR-005 任务模型） ----------------
INGEST_LEASE_SECONDS=60
INGEST_MAX_ATTEMPTS=3
INGEST_RETRY_BACKOFF_SECONDS=10

# ---------------- Agent 工作台（ADR-019，agent-harness Node sidecar） ----------------
# harness 协议服务器地址（FastAPI 网关 /api/harness/* 反代的上游）：
#   compose 部署：http://harness:4173（服务名，容器内网）
#   本地裸跑 sidecar（pnpm serve）：http://127.0.0.1:4173
HARNESS_BASE_URL=http://harness:4173
# 可选：覆盖 harness 侧上下文窗口/迭代上限（entrypoint 生成 config.yaml 时消费；
# 模型出口复用上面的 MODEL_GATEWAY_* 三项，与平台同源）
#HARNESS_CONTEXT_WINDOW=32768
#HARNESS_MAX_ITERATIONS=25
# harness KB 向量臂：sidecar 用宿主 Ollama 做 embedding（容器内 localhost 不可达）；
# Qdrant 为 compose 内置服务（compose 内自动连线），可选 pin 镜像版本
#HARNESS_OLLAMA_URL=http://host.docker.internal:11434
#QDRANT_IMAGE_TAG=v1.12.4
