# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 环境与密钥（.env.example 可提交，.env 含真实密钥不可提交）
.env

# IDE
.idea/
.vscode/

# 系统
.DS_Store

# 评测运行产物（baseline.json 为基线入库，last.json 每次运行重新生成，CI 自行产出并上传 artifact）
evals/results/last.json

# AgentDesk 工作区本地运行产物（容器内为命名卷；本地裸跑时 config 默认相对路径 ./workspaces）
workspaces/

# agent-harness sidecar（ADR-019）：TS 构建产物与运行时状态不入库
services/agent-harness/node_modules/
services/agent-harness/packages/*/dist/
services/agent-harness/*.tsbuildinfo
services/agent-harness/packages/*/*.tsbuildinfo
services/agent-harness/traces/
services/agent-harness/.harness/
